{
  "name": "command_catalog",
  "steps": [
    { "label": "Every catalog entry is routed",    "command": "CheckCommandCatalog", "expect": "OK" },
    { "label": "Unknown command reports an error", "command": "NoSuchCommand",       "expect_prefix": "ERROR:UnknownCommand" },
    { "label": "Loop can be set as a command",     "command": "SetLoop:0",           "expect": "OK:SetLoop" }
  ]
}
