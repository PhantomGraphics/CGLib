{
  "name": "csg_union",
  "steps": [
    { "label": "Clear world",                "command": "ClearWorld",                   "expect": "OK" },
    { "label": "Create sphere A at origin",  "command": "CreateSphere:0:0:0:10:1",      "expect_prefix": "OK:" },
    { "label": "Create sphere B offset",     "command": "CreateSphere:8:0:0:10:1",      "expect_prefix": "OK:" },
    { "label": "Record combined voxel count","command": "GetTotalVoxelCount",            "expect_prefix": "TotalVoxelCount:", "store_as": "vox2", "strip_prefix": "TotalVoxelCount:" },
    { "label": "CSG union of idx 0 and 1",  "command": "CSGCombine:Union:0:1",          "expect_prefix": "OK:" },
    { "label": "Scene count is 3",           "command": "GetSceneCount",                 "expect": "SceneCount:3" },
    { "label": "Total voxels changed",       "command": "GetTotalVoxelCount",            "expect_prefix": "TotalVoxelCount:", "expect_not": "TotalVoxelCount:${vox2}" }
  ]
}
