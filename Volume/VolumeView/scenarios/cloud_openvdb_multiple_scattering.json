{
  "name": "cloud_openvdb_multiple_scattering",
  "steps": [
    { "label": "Clear world",                        "command": "ClearWorld",                         "expect": "OK" },
    { "label": "Import converted OpenVDB cloud",     "command": "ImportVDB:samples/bunny_cloud_cglib.vdb", "expect": "OK:Imported_0:418338vx" },
    { "label": "Precondition: one scene",            "command": "GetSceneCount",                      "expect": "SceneCount:1" },
    { "label": "Apply OpenVDB density TF",           "command": "SetPBVRTFPreset:2",                  "expect": "OK" },
    { "label": "Switch to PBVR render",              "command": "SetPBVRRenderMode:1",                "expect": "OK" },
    { "label": "Fit real-scale cloud camera",        "command": "SetPBVRCameraDistance:80.0",         "expect": "OK" },
    { "label": "Use CPU particles",                  "command": "SetPBVRUseGPU:0",                    "expect": "OK" },
    { "label": "Set cloud density",                  "command": "SetPBVRDensityScale:10.0",           "expect": "OK" },
    { "label": "Enable self-shadow",                 "command": "SetPBVRShadowEnabled:1",             "expect": "OK" },
    { "label": "Set extinction",                     "command": "SetPBVRExtinction:4.0",              "expect": "OK" },
    { "label": "Set light direction",                "command": "SetPBVRLightDir:45:60",              "expect": "OK" },
    { "label": "Set cloud phase",                    "command": "SetPBVRPhaseG:0.85",                 "expect": "OK" },
    { "label": "Set cloud-like albedo",              "command": "SetPBVRScatteringAlbedo:0.99",       "expect": "OK" },
    { "label": "Set probe count",                    "command": "SetPBVRProbeCount:256",              "expect": "OK" },
    { "label": "Set probe radius",                   "command": "SetPBVRProbeRadius:8.0",             "expect": "OK" },
    { "label": "Set exposure",                       "command": "SetPBVRScatteringExposure:50.0",     "expect": "OK" },
    { "label": "Baseline: single scattering only",   "command": "SetPBVRScatteringOrders:0",          "expect": "OK" },
    { "label": "Enable probe scattering (one solve)", "command": "SetPBVRMultipleScattering:1",       "expect": "OK" },
    { "label": "Solve frame 1",                      "command": "GetSceneCount",                      "expect": "SceneCount:1" },
    { "label": "Solve frame 2",                      "command": "GetSceneCount",                      "expect": "SceneCount:1" },
    { "label": "Precondition: no indirect at 0 orders", "command": "GetPBVRMeanIndirectRadiance",     "expect_range": "0,0" },
    { "label": "Invariant: dense cloud self-shadows", "command": "GetPBVRMeanSunTransmittance",       "expect_range": "0.001,0.9" },
    { "label": "Baseline radiance (single)",         "command": "GetPBVRMeanScatteredRadiance",       "expect_range": "0.000001,100", "store_as": "m_single" },
    { "label": "Add two scattering orders",          "command": "SetPBVRScatteringOrders:2",          "expect": "OK" },
    { "label": "Solve frame 3",                      "command": "GetSceneCount",                      "expect": "SceneCount:1" },
    { "label": "Solve frame 4",                      "command": "GetSceneCount",                      "expect": "SceneCount:1" },
    { "label": "Change: indirect light appears",     "command": "GetPBVRMeanIndirectRadiance",        "expect_range": "0.000001,100", "store_as": "m_indirect" },
    { "label": "Radiance with multiple scattering",  "command": "GetPBVRMeanScatteredRadiance",       "expect_range": "0.000001,100", "store_as": "m_multi" },
    { "label": "Screenshot",                         "command": "Screenshot:screenshots/cloud_openvdb_multiple_scattering.png", "expect_prefix": "OK:" }
  ],
  "post_assert": "m_multi > m_single"
}
