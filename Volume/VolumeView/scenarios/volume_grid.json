{
  "name": "volume_grid",
  "steps": [
    { "label": "Clear world",          "command": "ClearWorld",                 "expect": "OK" },
    { "label": "Create sphere",        "command": "CreateSphere:0:0:0:10:1",    "expect_prefix": "OK:" },
    { "label": "Enable volume grid",   "command": "SetShowVolumeGrid:1",        "expect": "OK" },
    { "label": "Disable vector field", "command": "SetShowVectorField:0",       "expect": "OK" },
    { "label": "Grid enabled check",   "command": "GetVoxelCount",              "expect_prefix": "VoxelCount:" }
  ]
}
