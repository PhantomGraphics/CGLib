{
  "name": "resample",
  "steps": [
    { "label": "Clear world",                "command": "ClearWorld",              "expect": "OK" },
    { "label": "Create sphere cell=2",       "command": "CreateSphere:0:0:0:10:2", "expect_prefix": "OK:" },
    { "label": "Record coarse voxel count",  "command": "GetTotalVoxelCount",      "expect_prefix": "TotalVoxelCount:", "store_as": "coarse", "strip_prefix": "TotalVoxelCount:" },
    { "label": "Set active scene to idx 0",  "command": "SetActiveScene:0",        "expect": "OK" },
    { "label": "Resample to cell=1",         "command": "Resample:1",              "expect_prefix": "OK:" },
    { "label": "Scene count is 2",           "command": "GetSceneCount",           "expect": "SceneCount:2" },
    { "label": "Fine voxel count differs",   "command": "GetTotalVoxelCount",      "expect_prefix": "TotalVoxelCount:", "expect_not": "TotalVoxelCount:${coarse}" }
  ]
}
