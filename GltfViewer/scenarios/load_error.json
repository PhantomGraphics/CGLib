{
  "name": "load_error",
  "steps": [
    { "label": "Load nonexistent file returns error",
      "command": "LoadFile:scenarios/models/does_not_exist.gltf",
      "expect_prefix": "Error:" },
    { "label": "Mesh count unchanged (still 0)",
      "command": "GetMeshCount",
      "expect": "MeshCount:0" },
    { "label": "App alive after error",
      "command": "GetStatus",
      "expect": "OK" }
  ]
}
