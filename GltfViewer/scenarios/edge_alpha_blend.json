{
  "name": "edge_alpha_blend",
  "steps": [
    { "label": "Load alpha_blend_mode.gltf (alphaMode/alphaCutoff not supported -- must load without crashing)",
      "command": "LoadFile:scenarios/models/alpha_blend_mode.gltf",
      "expect_prefix": "OK:" },
    { "label": "Has meshes",     "command": "GetMeshCount",     "expect_not": "MeshCount:0" },
    { "label": "Has materials", "command": "GetMaterialCount", "expect_not": "MaterialCount:0" },
    { "label": "App still alive", "command": "GetStatus", "expect": "OK" },
    { "label": "Save screenshot (known limitation: all materials render fully opaque regardless of alphaMode)",
      "command": "SaveScreenshot:scenarios/screenshots/edge_alpha_blend.png",
      "expect_prefix": "OK:" }
  ]
}
