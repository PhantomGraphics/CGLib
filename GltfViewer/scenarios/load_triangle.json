{
  "name": "load_triangle",
  "steps": [
    { "label": "Load triangle.gltf",
      "command": "LoadFile:scenarios/models/triangle.gltf",
      "expect_prefix": "OK:" },
    { "label": "MeshCount = 1",       "command": "GetMeshCount",      "expect": "MeshCount:1" },
    { "label": "NodeCount = 1",       "command": "GetNodeCount",      "expect": "NodeCount:1" },
    { "label": "SceneCount = 1",      "command": "GetSceneCount",     "expect": "SceneCount:1" },
    { "label": "MaterialCount = 0",   "command": "GetMaterialCount",  "expect": "MaterialCount:0" },
    { "label": "TextureCount = 0",    "command": "GetTextureCount",   "expect": "TextureCount:0" },
    { "label": "PrimitiveCount = 1",  "command": "GetPrimitiveCount", "expect": "PrimitiveCount:1" },
    { "label": "App still alive",     "command": "GetStatus",         "expect": "OK" }
  ]
}
