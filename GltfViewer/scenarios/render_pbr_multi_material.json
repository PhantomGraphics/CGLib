{
  "name": "render_pbr_multi_material",
  "steps": [
    { "label": "Load pbr_multi_material.gltf",
      "command": "LoadFile:scenarios/models/pbr_multi_material.gltf",
      "expect_prefix": "OK:" },
    { "label": "Has meshes",     "command": "GetMeshCount",      "expect_not": "MeshCount:0" },
    { "label": "Has materials", "command": "GetMaterialCount",  "expect_not": "MaterialCount:0" },
    { "label": "SceneCount = 1", "command": "GetSceneCount",     "expect":     "SceneCount:1" },
    { "label": "Has primitives", "command": "GetPrimitiveCount", "expect_not": "PrimitiveCount:0" },
    { "label": "Has textures",   "command": "GetTextureCount",   "expect_not": "TextureCount:0" },
    { "label": "Save screenshot",
      "command": "SaveScreenshot:scenarios/screenshots/render_pbr_multi_material.png",
      "expect_prefix": "OK:" }
  ]
}
