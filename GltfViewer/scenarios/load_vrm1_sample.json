{
  "name": "load_vrm1_sample",
  "steps": [
    { "label": "Load vrm1_synthetic.vrm (VRM 1.0)",
      "command": "LoadFile:scenarios/models/vrm1_synthetic.vrm",
      "expect_prefix": "OK:" },
    { "label": "Has meshes",  "command": "GetMeshCount",  "expect_not": "MeshCount:0" },
    { "label": "Has skin (humanoid rig)", "command": "GetSkinCount", "expect_not": "SkinCount:0" },
    { "label": "Detected as VRM 1.0", "command": "GetVrmSpecVersion", "expect": "Val:1" },
    { "label": "Humanoid bones mapped", "command": "GetVrmHumanBoneCount", "expect_not": "Count:0" },
    { "label": "Expressions parsed", "command": "GetVrmExpressionCount", "expect_not": "Count:0" },
    { "label": "Drive first expression to 0.5", "command": "SetVrmExpressionWeight:0:0.5", "expect": "OK" },
    { "label": "Save screenshot (bind pose + expression applied)",
      "command": "SaveScreenshot:scenarios/screenshots/vrm1_synthetic.png",
      "expect_prefix": "OK:" }
  ]
}
