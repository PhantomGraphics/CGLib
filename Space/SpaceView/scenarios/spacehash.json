{
  "name": "spacehash",
  "steps": [
    { "label": "Select SpaceHash", "command": "SetAlgorithm:SpaceHash", "expect": "OK" },
    { "label": "Run SpaceHash", "command": "Run", "expect": "OK" },
    { "label": "Result not dirty", "command": "GetDirty", "expect": "Dirty:0" },
    { "label": "Line indices greater than 0", "command": "GetLineCount", "expect_prefix": "LineCount:", "expect_not": "LineCount:0" },
    { "label": "Set small radius", "command": "SetParam:SearchRadius:0.10", "expect": "OK" },
    { "label": "Run with small radius", "command": "Run", "expect": "OK" },
    { "label": "Record small line count", "command": "GetLineCount", "expect_prefix": "LineCount:", "store_as": "small_lines", "strip_prefix": "LineCount:" },
    { "label": "Set large radius", "command": "SetParam:SearchRadius:0.80", "expect": "OK" },
    { "label": "Run with large radius", "command": "Run", "expect": "OK" },
    { "label": "Line count changed with larger radius", "command": "GetLineCount", "expect_prefix": "LineCount:", "expect_not": "LineCount:${small_lines}" }
  ]
}
